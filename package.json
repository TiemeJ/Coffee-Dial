{
  "name": "coffee-dial",
  "private": true,
  "scripts": {
    "build:css:tailwind": "tailwindcss -c tailwind.config.cjs -i ./src/styles/tailwind.input.css -o ./vendor/css/tailwind.generated.min.css --minify",
    "backfill:photo-paths:dry": "node scripts/backfill-photo-paths.mjs",
    "backfill:photo-paths:apply": "node scripts/backfill-photo-paths.mjs --apply",
    "migrate:grinder-to-gear:dry": "node scripts/migrate-grinder-to-gear.mjs",
    "migrate:grinder-to-gear:apply": "node scripts/migrate-grinder-to-gear.mjs --apply",
    "backfill:legacy-grinder-from-gear:dry": "node scripts/fill-legacy-grinder-from-gear.mjs",
    "backfill:legacy-grinder-from-gear:apply": "node scripts/fill-legacy-grinder-from-gear.mjs --apply",
    "backfill:sync-legacy-beans:dry": "node scripts/sync-legacy-beans.mjs",
    "backfill:sync-legacy-beans:apply": "node scripts/sync-legacy-beans.mjs --apply",
    "backfill:bean-dates-from-brews:dry": "node scripts/backfill-bean-dates-from-brews.mjs",
    "backfill:bean-dates-from-brews:apply": "node scripts/backfill-bean-dates-from-brews.mjs --apply",
    "backfill:coffee-type-decaf:dry": "node scripts/backfill-coffee-type-decaf-from-scan.mjs",
    "backfill:coffee-type-decaf:apply": "node scripts/backfill-coffee-type-decaf-from-scan.mjs --apply",
    "backfill:extract-coffee-types:dry": "node scripts/extract-coffee-types-from-beans.mjs",
    "backfill:extract-coffee-types:apply": "node scripts/extract-coffee-types-from-beans.mjs --apply",
    "backfill:beans-left-missing:dry": "node scripts/maybe-migrate-beans-left.mjs",
    "backfill:beans-left-missing:apply": "node scripts/maybe-migrate-beans-left.mjs --apply",
    "backfill:beans-left-recalculate:dry": "node scripts/recalculate-all-beans-left.mjs",
    "backfill:public-profiles:dry": "node scripts/backfill-public-profiles.mjs",
    "backfill:public-profiles:apply": "node scripts/backfill-public-profiles.mjs --apply",
    "migrations:all:dry": "node scripts/run-all-migrations.mjs",
    "migrations:all:apply": "node scripts/run-all-migrations.mjs --apply",
    "backfill:beans-left-recalculate:apply": "node scripts/recalculate-all-beans-left.mjs --apply",
    "check:stage4": "node scripts/check-feature-boundaries.mjs && node scripts/check-command-ownership.mjs && node scripts/check-command-dispatch-coverage.mjs",
    "test:smoke:e2e": "playwright test -c playwright.config.mjs",
    "test:smoke:e2e:headed": "playwright test -c playwright.config.mjs --headed"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "tailwindcss": "^3.4.17"
  }
}
